# Bolt - environment variables
# Copy this file to .env.local for local development, and add the same
# values in Vercel under Project Settings > Environment Variables.
# Never commit the real .env.local - only this .example file with placeholders.

# --- Supabase (Project Settings > API, and Project Settings > Database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: used only server-side (in the API route), never exposed
# to the browser. Found on the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=

# --- EMQX Cloud Serverless (deployment's Connection / Overview page) ---
EMQX_BROKER_HOST=
EMQX_BROKER_PORT=
EMQX_MQTT_USERNAME=
EMQX_MQTT_PASSWORD=
# A shared secret the EMQX Rule Engine sends with its webhook calls, so the
# API route can confirm a request genuinely came from EMQX and not from
# anywhere else on the internet. Make this up yourself (any long random
# string) and enter the same value on both sides when you configure the rule.
EMQX_WEBHOOK_SECRET=

# --- Cloudflare R2 (only needed once you start storing files) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# --- Firebase Cloud Messaging (push alerts) ---
# Firebase project settings > Service accounts > Generate new private key
# gives you a JSON file - store its contents here as one line, or follow
# whichever Firebase Admin SDK setup method we use when we build the alerts.
FIREBASE_SERVICE_ACCOUNT_JSON=
